# Copy to .env and fill in values. Never commit .env.

# PostgreSQL (used by the docker compose "db" service)
POSTGRES_USER=pitchsense
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pitchsense

# Used when running the backend or pytest directly on your machine.
# docker compose builds its own URL pointing at the "db" service.
DATABASE_URL=postgresql+psycopg://pitchsense:change-me@localhost:5432/pitchsense

ENVIRONMENT=development

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Public URL of the API, baked into the frontend at build time (not a secret)
VITE_API_URL=http://localhost:8000
